{
  "name": "wenay-common2",
  "version": "2.2.2",
  "description": "Typed RPC over sockets, replayable Listen wires, reactive stores with replication and failover, peer packet mesh, media/artifact/AI/conversation runtimes",
  "keywords": [
    "rpc",
    "socket.io",
    "replay",
    "reactive-store",
    "replication",
    "failover",
    "webrtc",
    "peer-mesh",
    "typescript"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "private": true,
  "bin": {
    "wenay-https": "./lib/cli/wenay-https.js"
  },
  "scripts": {
    "test": "npm run test:rpc-guards && npm run test:types && npm run test:spec-types && npm run test:rpc && npm run test:rpc-markers && npm run test:https && npm run --prefix ./test test",
    "build & watch": "npm run _clearDir  &&  tsc --watch",
    "build": "npm run _clearDir  &&  tsc --build --verbose  &&  npm run _afterBuild",
    "types:generate": "tsc -p tsconfig.json --emitDeclarationOnly",
    "types:watch": "tsc -p tsconfig.json --emitDeclarationOnly --watch",
    "_afterBuild": "node copyCompiledFiles.mjs ./dist  &&  cd dist  &&  npm pkg delete scripts devDependencies private",
    "pack": "npm run _afterBuild  &&  npm pack ./dist",
    "_publish": "npm run test  &&  npm publish ./dist",
    "publish": "npm run _afterBuild  &&  npm run _publish",
    "build & publish": "npm run build  &&  npm run _publish",
    "_clearDir": "node scripts/clear-lib.mjs",
    "demo:build": "esbuild demo/client.ts --bundle --minify --platform=browser --outfile=demo/public/client.js  &&  copy /Y demo\\index.html demo\\public\\index.html",
    "demo:build:debug": "esbuild demo/client.ts --bundle --platform=browser --outfile=demo/public/client.js  &&  copy /Y demo\\index.html demo\\public\\index.html",
    "demo": "npm run demo:build  &&  tsx demo/server.ts",
    "demo:mirror": "npm run demo:build  &&  node scripts/start-demo-mirror.cjs",
    "demo:https": "powershell -ExecutionPolicy Bypass -File scripts/start-demo-https.ps1",
    "demo:https:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-demo-https.ps1 -Stop",
    "https": "tsx src/cli/wenay-https.ts",
    "test:rpc-guards": "node scripts/assert-rpc-symbol-guard.cjs",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test:spec-types": "tsc -p tsconfig.spec.json",
    "test:rpc": "tsx src/Common/rcp/rpc.harness.spec.ts",
    "test:rpc-markers": "tsx src/Common/rcp/rpc-marker-contract.spec.ts",
    "test:https": "tsx src/Common/https/https-config.spec.ts",
    "test:all": "npm run test:rpc-guards && npm run test:types && npm run test:spec-types && npm run test:rpc && npm run test:rpc-markers && npm run test:https && node scripts/run-oracles.mjs",
    "test:stress": "node scripts/run-oracles.mjs --stress",
    "test:stress:extended": "npm run test:stress && node scripts/run-oracles.mjs --extended-stress",
    "experiment:transport": "tsx experiments/transport-2026-07/bench.ts",
    "experiment:rpc-perf": "tsx experiments/rpc-perf-2026-07/bench.ts",
    "experiment:store-load": "tsx experiments/store-sync-load-2026-07/bench.ts"
  },
  "files": [
    "lib/**/*",
    "doc/**/*",
    "replay/**/*",
    "observe/**/*",
    "oracle/**/*",
    "demo/**/*",
    "CLAUDE.md",
    "rpc.md",
    "!doc/target/**/*",
    "!doc/progress/**/*",
    "!demo/public/**/*",
    "!**/*.tsbuildinfo"
  ],
  "author": "wenay",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenayr/wenay-common2.git"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socket.io-msgpack-parser": "^3.0.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./observe": "./lib/Common/Observe/index.js",
    "./replay": "./lib/Common/events/replay-index.js",
    "./lib/client": "./lib/client.js",
    "./lib/server": "./lib/server.js",
    "./client": "./lib/client.js",
    "./server": "./lib/server.js",
    "./package.json": "./package.json",
    "./media": "./lib/Common/media/media-index.js",
    "./peer": "./lib/Common/peer/peer-index.js",
    "./resource": "./lib/Common/resource/resource-index.js",
    "./ai": "./lib/Common/ai/ai-index.js",
    "./artifact": "./lib/Common/artifact/artifact-index.js",
    "./conversation": "./lib/Common/conversation/conversation-index.js",
    "./contract": "./lib/Common/contract/contract-index.js",
    "./https": "./lib/Common/https/https-index.js"
  }
}
