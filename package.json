{
  "name": "wenay-common2",
  "version": "2.12.1",
  "description": "Typed RPC over sockets, replayable Listen wires, reactive stores with replication and failover, peer packet mesh, media/artifact/AI/conversation runtimes",
  "keywords": [
    "rpc",
    "socket.io",
    "replay",
    "reactive-store",
    "replication",
    "failover",
    "webrtc",
    "peer-mesh",
    "typescript"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "private": true,
  "bin": {
    "wenay-https": "./lib/cli/wenay-https.js"
  },
  "scripts": {
    "test": "npm run test:rpc-guards && npm run test:types && npm run test:spec-types && npm run test:console && npm run test:rpc && npm run test:rpc-flow && npm run test:rpc-markers && npm run test:https && npm run test:dynamic-runtime && npm run --prefix ./test test",
    "build & watch": "npm run _clearDir  &&  tsc --watch",
    "build": "npm run _clearDir  &&  tsc --build --verbose  &&  npm run _afterBuild",
    "types:generate": "tsc -p tsconfig.json --emitDeclarationOnly",
    "types:watch": "tsc -p tsconfig.json --emitDeclarationOnly --watch",
    "_afterBuild": "node copyCompiledFiles.mjs ./dist  &&  cd dist  &&  npm pkg delete scripts devDependencies private",
    "release:verify": "npm run build  &&  npm test  &&  node scripts/run-oracles.mjs  &&  npm pack ./dist --dry-run",
    "pack": "npm run release:verify  &&  npm pack ./dist",
    "_publish": "npm run release:verify  &&  npm publish ./dist",
    "publish": "npm run _publish",
    "build & publish": "npm run publish",
    "_clearDir": "node scripts/clear-lib.mjs",
    "demo:build": "esbuild demo/client.ts --bundle --minify --platform=browser --outfile=demo/public/client.js  &&  copy /Y demo\\index.html demo\\public\\index.html",
    "demo:build:debug": "esbuild demo/client.ts --bundle --platform=browser --outfile=demo/public/client.js  &&  copy /Y demo\\index.html demo\\public\\index.html",
    "demo": "npm run demo:build  &&  tsx demo/server.ts",
    "demo:mirror": "npm run demo:build  &&  node scripts/start-demo-mirror.cjs",
    "demo:https": "powershell -ExecutionPolicy Bypass -File scripts/start-demo-https.ps1",
    "demo:https:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-demo-https.ps1 -Stop",
    "https": "tsx src/cli/wenay-https.ts",
    "test:rpc-guards": "node scripts/assert-rpc-symbol-guard.cjs",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test:spec-types": "tsc -p tsconfig.spec.json",
    "test:console": "tsx src/Common/node-console.spec.ts",
    "test:rpc": "tsx src/Common/rcp/rpc.harness.spec.ts",
    "test:rpc-flow": "tsx src/Common/rcp/rpc-flow.spec.ts",
    "test:rpc-markers": "tsx src/Common/rcp/rpc-marker-contract.spec.ts",
    "test:https": "tsx src/Common/https/https-config.spec.ts",
    "test:dynamic-runtime": "tsx observe/dynamic-module-manifest.test.ts && tsx observe/dynamic-module-worker.test.ts && tsx observe/dynamic-module-mcp-registrar.test.ts && tsx observe/dynamic-module-runtime.test.ts && tsx observe/dynamic-module-host-races.test.ts && tsx observe/dynamic-module-artifact-registry.test.ts && tsx observe/dynamic-module-rollout-journal.test.ts && tsx experiments/dynamic-runtime/fleet-self-client.ts",
    "test:dynamic-runtime:acceptance": "npm run test:dynamic-runtime && tsx oracle/realsocket/contract-runtime.spec.ts && tsx oracle/realsocket/replay-reconnect.spec.ts && tsx oracle/realsocket/store-chaos.spec.ts && tsx replay/offline-store-socket.test.ts && tsx observe/store-replica-set.test.ts",
    "test:all": "npm run test:rpc-guards && npm run test:types && npm run test:spec-types && npm run test:rpc && npm run test:rpc-flow && npm run test:rpc-markers && npm run test:https && node scripts/run-oracles.mjs",
    "test:stress": "node scripts/run-oracles.mjs --stress",
    "test:stress:extended": "npm run test:stress && node scripts/run-oracles.mjs --extended-stress",
    "experiment:transport": "tsx experiments/transport-2026-07/bench.ts",
    "experiment:slow-network": "tsx experiments/slow-network-2026-08/bench.ts",
    "experiment:store-lazy": "tsx experiments/store-lazy-2026-08/bench.ts",
    "experiment:rpc-perf": "tsx experiments/rpc-perf-2026-07/bench.ts",
    "experiment:store-load": "tsx experiments/store-sync-load-2026-07/bench.ts",
    "experiment:store-view": "node --expose-gc --import tsx experiments/store-replay-view-2026-07/bench.ts",
    "experiment:agent-control": "tsx experiments/dynamic-runtime/agent-control-self-client.ts",
    "experiment:dynamic-tools": "tsx experiments/dynamic-runtime/dynamic-tools-self-client.ts",
    "experiment:dynamic-runtime:mcp": "tsx experiments/dynamic-runtime/runtime-self-client.ts",
    "experiment:dynamic-runtime:contributions": "tsx experiments/dynamic-runtime/contribution-self-client.ts",
    "experiment:dynamic-runtime:fleet": "tsx experiments/dynamic-runtime/fleet-self-client.ts"
  },
  "files": [
    "lib/**/*",
    "doc/**/*",
    "replay/**/*",
    "observe/**/*",
    "oracle/**/*",
    "demo/**/*",
    "CLAUDE.md",
    "rpc.md",
    "!doc/target/**/*",
    "!doc/progress/**/*",
    "!demo/public/**/*",
    "!**/*.tsbuildinfo"
  ],
  "author": "wenay",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenayr/wenay-common2.git"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socket.io-msgpack-parser": "^3.0.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "exports": {
    ".": "./lib/index.js",
    "./observe": "./lib/Common/Observe/index.js",
    "./replay": "./lib/Common/events/replay-index.js",
    "./listen": "./lib/Common/events/listen-index.js",
    "./rpc": "./lib/Common/rcp/rpc-index.js",
    "./debug-console": "./lib/debug-console.js",
    "./lib/client": "./lib/client.js",
    "./lib/server": "./lib/server.js",
    "./client": "./lib/client.js",
    "./server": "./lib/server.js",
    "./package.json": "./package.json",
    "./media": "./lib/Common/media/media-index.js",
    "./peer": "./lib/Common/peer/peer-index.js",
    "./resource": "./lib/Common/resource/resource-index.js",
    "./ai": "./lib/Common/ai/ai-index.js",
    "./artifact": "./lib/Common/artifact/artifact-index.js",
    "./conversation": "./lib/Common/conversation/conversation-index.js",
    "./contract": "./lib/Common/contract/contract-index.js",
    "./https": "./lib/Common/https/https-index.js",
    "./server/fs": "./lib/server/fs-index.js",
    "./server/auth": "./lib/server/auth-token.js",
    "./server/http": "./lib/server/httpFacadeServer.js",
    "./server/webhook": "./lib/server/WebHook3.js"
  }
}
