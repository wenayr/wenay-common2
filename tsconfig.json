{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    //"module": "ESNext",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": false,
    "allowJs": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strict": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./lib",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "esnext"
    ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/*"
      ],
    }
  },

  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "**/*.spec.ts",
    "./src/Common/rcp/exampleWebFacade.ts",
    "./noBuild/**/*",
    "node_modules",
    "../node_modules",
  ],
}

