{
  "name": "wenay-common2",
  "version": "2.10.0",
  "description": "Typed RPC over sockets, replayable Listen wires, reactive stores with replication and failover, peer packet mesh, media/artifact/AI/conversation runtimes",
  "keywords": [
    "rpc",
    "socket.io",
    "replay",
    "reactive-store",
    "replication",
    "failover",
    "webrtc",
    "peer-mesh",
    "typescript"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "wenay-https": "./lib/cli/wenay-https.js"
  },
  "files": [
    "lib/**/*",
    "doc/**/*",
    "replay/**/*",
    "observe/**/*",
    "oracle/**/*",
    "demo/**/*",
    "CLAUDE.md",
    "rpc.md",
    "!doc/target/**/*",
    "!doc/progress/**/*",
    "!demo/public/**/*",
    "!**/*.tsbuildinfo"
  ],
  "author": "wenay",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenayr/wenay-common2.git"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./observe": "./lib/Common/Observe/index.js",
    "./replay": "./lib/Common/events/replay-index.js",
    "./listen": "./lib/Common/events/listen-index.js",
    "./rpc": "./lib/Common/rcp/rpc-index.js",
    "./debug-console": "./lib/debug-console.js",
    "./lib/client": "./lib/client.js",
    "./lib/server": "./lib/server.js",
    "./client": "./lib/client.js",
    "./server": "./lib/server.js",
    "./package.json": "./package.json",
    "./media": "./lib/Common/media/media-index.js",
    "./peer": "./lib/Common/peer/peer-index.js",
    "./resource": "./lib/Common/resource/resource-index.js",
    "./ai": "./lib/Common/ai/ai-index.js",
    "./artifact": "./lib/Common/artifact/artifact-index.js",
    "./conversation": "./lib/Common/conversation/conversation-index.js",
    "./contract": "./lib/Common/contract/contract-index.js",
    "./https": "./lib/Common/https/https-index.js",
    "./server/fs": "./lib/server/fs-index.js",
    "./server/auth": "./lib/server/auth-token.js",
    "./server/http": "./lib/server/httpFacadeServer.js",
    "./server/webhook": "./lib/server/WebHook3.js"
  }
}
