{
  "name": "test",
  "version": "1.0.0",
  "//type": "module",
  "scripts": {
    "_del_wenay": "IF exist node_modules\\wenay-common2 (rd /s /q node_modules\\wenay-common2)",
    "_mklink": "npm run _del_wenay  &&  mklink /J node_modules\\wenay-common2 ..\\dist",
    "installLink": "npm install",
    "installCopy": "del package-lock.json  &&  npm run _del_wenay &&  npm install --install-links",
    "_prepare": "node prepare.mjs",
    "test": "npm run _prepare  &&  tsc --incremental  &&  node --enable-source-maps dist/test.js"
  },
  "dependencies": {
    "test": "file:",
    "wenay-common2": "file:../dist"
  }
}
